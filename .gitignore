# Environnement et fichiers locaux
.venv/
__pycache__/
.pytest_cache/
logs/
*.tmp
*.part

# Caches météo (re-téléchargés) et état local
data/gfs/
data/gefs/
data/position.json
data/positions/
data/relay-state.json
data/.relais-nouveau
data/.*.lock

# Sources brutes : lourdes (côtes GSHHG 118 Mo) ou documents de tiers (PDF des IC, code d'outils communautaires)
data/geo/sources/
data/course/sources/
data/polar/sources/code/

# Fichiers produits par les calculs (publiés par GitHub Actions, pas versionnés)
web/data/*
!web/data/coast.geojson
!web/data/coast-detail.geojson
!web/data/course.geojson

# Masque : publié en morceaux (mask.npz.part*) ; fichiers GRIB de test gardés en local
data/geo/mask.npz
tests/fixtures/*.grb2
